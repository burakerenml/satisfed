# Copy to `.env.<your-firebase-project-id>` (gitignored). Firebase reads it
# at deploy time and sets these as environment variables on every function.
#
# The two secrets are NOT set here. Store them in Secret Manager:
#   firebase functions:secrets:set AZURE_OPENAI_API_KEY
#   firebase functions:secrets:set REVENUECAT_SECRET_KEY
#   firebase functions:secrets:set REVENUECAT_WEBHOOK_SECRET

# Your Azure OpenAI resource, no trailing slash.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# The deployment (model) name inside that resource. It must accept images.
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# false runs the paywall gate in report-only mode.
PAYWALL_ENFORCE=true

# How hard the AI can be leaned on (see src/limits.ts). Per id: a human
# pace. The two daily budgets are shared by everyone; AI_GLOBAL_PER_DAY is
# the ceiling on the Azure bill.
AI_PER_ID_PER_MINUTE=10
AI_PER_ID_PER_DAY=100
AI_FREE_TIER_GLOBAL_PER_DAY=1500
AI_GLOBAL_PER_DAY=5000
FRESH_PER_ID_PER_HOUR=12
